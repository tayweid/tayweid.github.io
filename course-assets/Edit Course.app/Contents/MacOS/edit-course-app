#!/bin/bash
# Edit Course.app: starts course-assets/edit-course in the background; it opens the editor
# in the default browser and stops itself a few minutes after the last editor tab closes.
# Launching again while it runs just opens another tab.
#
# The app looks at the folder it sits in. Copied into a course folder (one holding
# course-content.yaml.js), it opens that course, finding course-assets in the sibling
# checkout, ../tayweid.github.io/course-assets. Left in course-assets, it opens the picker.

home="$(cd "$(dirname "$0")/../../.." && pwd)"
if [ -f "$home/course-content.yaml.js" ]; then
    site="$home"
    assets="$(cd "$home/../tayweid.github.io/course-assets" 2>/dev/null && pwd)"
elif [ -f "$home/edit-course" ]; then
    site=""
    assets="$home"
else
    osascript -e 'display alert "Edit Course has no course here" message "Put this app in a course folder, the one holding course-content.yaml.js, and open it from there (or drag it to the Dock from there)."'
    exit 1
fi
if [ -z "$assets" ] || [ ! -f "$assets/edit-course" ]; then
    osascript -e 'display alert "Edit Course cannot find course-assets" message "It looks for tayweid.github.io/course-assets beside this course folder."'
    exit 1
fi

# Apps opened from Finder get a bare PATH, so look for Python where it usually lives.
for python in /opt/homebrew/bin/python3 /usr/local/bin/python3 /opt/anaconda3/bin/python3 "$HOME/anaconda3/bin/python3" /usr/bin/python3; do
    [ -x "$python" ] && break
done

nohup "$python" "$assets/edit-course" ${site:+"$site"} >> "$HOME/Library/Logs/Edit Course.log" 2>&1 &
