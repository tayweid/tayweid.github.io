#!/bin/bash
# Edit Course.app: starts course-assets/edit-course in the background; it opens the editor
# in the default browser and stops itself a few minutes after the last editor tab closes.
# Launching again while it runs just opens another tab.
#
# Kept in course-assets/, it opens the course picker. A copy made by
# `edit-course --make-app SITE` sits in the course folder and opens that course, finding
# course-assets in the sibling checkout, ../tayweid.github.io/course-assets.

home="$(cd "$(dirname "$0")/../../.." && pwd)"
if [ -f "$home/edit-course" ]; then
    assets="$home"
    site=""
else
    assets="$(cd "$home/../tayweid.github.io/course-assets" 2>/dev/null && pwd)"
    site="$home"
fi
if [ -z "$assets" ] || [ ! -f "$assets/edit-course" ]; then
    osascript -e 'display alert "Edit Course cannot find edit-course" message "The shared app belongs in tayweid.github.io/course-assets; a course copy belongs in its course folder, beside a tayweid.github.io checkout. Drag it to the Dock from there rather than moving it."'
    exit 1
fi

# Apps opened from Finder get a bare PATH, so look for Python where it usually lives.
for python in /opt/homebrew/bin/python3 /usr/local/bin/python3 /opt/anaconda3/bin/python3 "$HOME/anaconda3/bin/python3" /usr/bin/python3; do
    [ -x "$python" ] && break
done

nohup "$python" "$assets/edit-course" ${site:+"$site"} >> "$HOME/Library/Logs/Edit Course.log" 2>&1 &
